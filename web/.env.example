# ============================================
# XBot Framework - Web Configuration
# ============================================

# Base URL for the website (used for OG image URLs)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Bot username on X (for landing page links)
NEXT_PUBLIC_BOT_USERNAME=ReserveBot_

# ============================================
# Redis Storage (Upstash)
# ============================================
# Auto-populated when you add Upstash KV via Vercel integrations
# Or manually set from https://console.upstash.com/

KV_REST_API_URL=
KV_REST_API_TOKEN=

# ============================================
# Branding Configuration
# ============================================
# Customize the look and feel of your bot's web presence
# Dark theme with saturated red accents

# Bot identity
NEXT_PUBLIC_BRAND_NAME=ReservationBot
NEXT_PUBLIC_BRAND_TAGLINE=AI-Powered Restaurant Reservations
NEXT_PUBLIC_BRAND_LOGO=🍽️

# Colors (dark + saturated red)
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#0a0a0a
NEXT_PUBLIC_BRAND_SECONDARY_COLOR=#b91c1c
NEXT_PUBLIC_BRAND_ACCENT_COLOR=#ffffff

# Gradients (CSS gradient syntax)
NEXT_PUBLIC_BRAND_BG_GRADIENT=linear-gradient(135deg, #0a0a0a 0%, #171717 50%, #0a0a0a 100%)
NEXT_PUBLIC_BRAND_BUTTON_GRADIENT=linear-gradient(90deg, #b91c1c, #dc2626)
NEXT_PUBLIC_BRAND_TEXT_GRADIENT=linear-gradient(90deg, #dc2626, #ef4444)

# Card styling
NEXT_PUBLIC_BRAND_CARD_BG=rgba(23, 23, 23, 0.95)
NEXT_PUBLIC_BRAND_CARD_BORDER=rgba(185, 28, 28, 0.4)

# Attribution / Partner branding
NEXT_PUBLIC_BRAND_POWERED_BY=Powered by OpenTable
NEXT_PUBLIC_BRAND_POWERED_BY_URL=https://www.opentable.com

# Call-to-action button text
NEXT_PUBLIC_BRAND_CTA_TEXT=View on OpenTable →
