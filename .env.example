# X API Credentials
# Get these from https://developer.x.com/en/portal/dashboard

# OAuth 2.0 Bearer Token (for filtered stream - App-only auth)
X_BEARER_TOKEN=your_bearer_token_here

# OAuth 1.0a credentials (for posting tweets - User context auth)
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Bot Configuration
BOT_USERNAME=autobot_demo

# Website URL (for OG preview links in tweets)
WEBSITE_URL=https://autobot.vercel.app

# Expedia Group APIs (Hotels, Vrbo, Cars, Activities)
# Apply at https://developers.expediagroup.com/
# Leave empty to use SANDBOX mode with simulated data
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=
EXPEDIA_AFFILIATE_ID=
# Set to 'true' to force sandbox mode even with credentials
EXPEDIA_USE_SANDBOX=true
