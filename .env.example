# ============================================
# XBot Framework Configuration
# ============================================

# X API Credentials
# Get these from https://developer.x.com/en/portal/dashboard
X_BEARER_TOKEN=your_bearer_token_here
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Bot Configuration
BOT_USERNAME=your_bot_username

# Website URL (for OG preview links in tweets)
WEBSITE_URL=https://your-app.vercel.app

# Grok API (xAI) - REQUIRED for bot functionality
# Get your API key from https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# ============================================
# Plugin Configuration
# ============================================

# Which plugin to use
# Available: expedia, opentable
BOT_PLUGIN=opentable

# Set to 'true' to use sandbox/test mode
PLUGIN_SANDBOX_MODE=true

# ============================================
# Expedia Plugin Configuration
# (only needed if using the expedia plugin)
# ============================================

# Expedia Group APIs - Apply at https://developers.expediagroup.com/
# Leave empty to use SANDBOX mode with simulated data
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=
EXPEDIA_AFFILIATE_ID=
